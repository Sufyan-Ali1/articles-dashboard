# Full API prefix. This value is public and is embedded at build time.
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1

# Cloudflare Workers production: use the same-origin API proxy for persistent cookies.
# VITE_API_BASE_URL=/api/v1
# API_ORIGIN is configured in wrangler.toml (server-side).

# Public website origin used when copying tracking links.
VITE_SITE_URL=https://askandexplore.com
